// The Windows resources: the icon Explorer shows for tubes-port.exe, and the
// version its Properties > Details tab reports. CMake fills in the numbers
// from src/version.h, the one source of truth, and compiles this on Windows
// only. The icon is generated by tools/gen_icon.py.

#include <winver.h>

1 ICON "@TUBES_ICO@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Tubes"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "ProductName",      "tubes-port"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "tubes-port.exe"
            VALUE "InternalName",     "tubes-port"
            VALUE "Comments",         "A reimplementation of Tubes (1994). Plays the data from a copy of the original game."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
